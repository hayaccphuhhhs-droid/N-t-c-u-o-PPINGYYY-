RealFishBtn.Font = Enum.Font.GothamBold
RealFishBtn.TextSize = 16
RealFishBtn.Visible = false
RealFishBtn.BorderSizePixel = 0
Instance.new("UICorner", RealFishBtn).CornerRadius = UDim.new(1, 0)

-- Toggle nút câu ảo
local fishThipActive = false
FishThipBtn.MouseButton1Click:Connect(function()
    fishThipActive = not fishThipActive
    RealFishBtn.Visible = fishThipActive
    FishThipBtn.Text = "🟢 Nút Câu Ảo: " .. (fishThipActive and "BẬT" or "TẮT")
    FishThipBtn.BackgroundColor3 = fishThipActive and Color3.fromRGB(0, 150, 80) or Color3.fromRGB(150, 0, 0)
