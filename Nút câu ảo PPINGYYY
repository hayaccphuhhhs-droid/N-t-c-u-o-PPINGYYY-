local function mkTab(t, y)
    local b = Instance.new("TextButton", side)
    b.Size = UDim2.new(0.85,0,0,30)
    b.Position = UDim2.new(0.05,0,0,y)
    b.Text = t
    b.TextColor3 = Color3.fromRGB(150,150,150)
    b.BackgroundColor3 = Color3.fromRGB(20,20,25)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
    return b
end

local t1 = mkTab("Cau Ca", 4)
local t2 = mkTab("Ky Nang", 38)
local t3 = mkTab("Cong Cu", 72)

local function mkPage()
    local p = Instance.new("ScrollingFrame", pages)
    p.Size = UDim2.new(1,0,1,0)
    p.BackgroundTransparency = 1
    p.ScrollBarThickness = 2
    p.Visible = false
    return p
end

local p1,p2,p3 = mkPage(), mkPage(), mkPage()
local cur

local function sel(btn, page)
    for _,b in pairs({t1,t2,t3}) do
        if b == btn then
            b.BackgroundColor3 = Color3.fromRGB(0,180,100)
            b.TextColor3 = Color3.new(1,1,1)
        else
            b.BackgroundColor3 = Color3.fromRGB(20,20,25)
            b.TextColor3 = Color3.fromRGB(150,150,150)
        end
    end
    if cur then cur.Visible = false end
    page.Visible = true
    cur = page
end

t1.MouseButton1Click:Connect(function() sel(t1,p1) end)
t2.MouseButton1Click:Connect(function() sel(t2,p2) end)
t3.MouseButton1Click:Connect(function() sel(t3,p3) end)

local function mkBtn(parent, txt, y)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0.95,0,0,32)
    b.Position = UDim2.new(0.025,0,0,y)
    b.Text = txt
    b.BackgroundColor3 = Color3.fromRGB(150,0,0)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 10
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)
    return b
end

